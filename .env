# Application Configuration
APP_NAME=Contextual_RAG_CC
ENVIRONMENT=development

# Service Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
QDRANT_PORT=6333

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_API_KEY=

# Storage settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
STORAGE_DIR=backend/app/storage

# Contextual RAG Configurations
OLLAMA_HOST=http://localhost:11434
CONTEXT_MODEL=qwen3:14b
CONTEXT_MAX_WORDS=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Next.js API endpoint (Change localhost to your server's public IP when deploying to production)
NEXT_PUBLIC_API_URL=http://localhost:8000


